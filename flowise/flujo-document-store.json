    {
      "id": "customFunctionAgentflow_0",
      "type": "agentFlow",
      "data": {
        "id": "customFunctionAgentflow_0",
        "label": "Menú, privacidad y alcance",
        "version": 1,
        "name": "customFunctionAgentflow",
        "type": "CustomFunction",
        "color": "#E4B7FF",
        "baseClasses": [
          "CustomFunction"
        ],
        "category": "Agent Flows",
        "description": "Consulta fichas de orientación técnica y ofrece canales oficiales.",
        "inputParams": [
          {
            "name": "customFunctionInputVariables",
            "label": "Input Variables",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              {
                "name": "variableName",
                "label": "Variable Name",
                "type": "string"
              },
              {
                "name": "variableValue",
                "label": "Variable Value",
                "type": "string",
                "acceptVariable": true
              }
            ],
            "id": "customFunctionAgentflow_0-input-customFunctionInputVariables-array"
          },
          {
            "name": "customFunctionJavascriptFunction",
            "label": "Javascript Function",
            "type": "code",
            "id": "customFunctionAgentflow_0-input-customFunctionJavascriptFunction-code"
          },
          {
            "name": "customFunctionUpdateState",
            "label": "Update Flow State",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              {
                "name": "key",
                "label": "Key",
                "type": "asyncOptions",
                "loadMethod": "listRuntimeStateKeys",
                "freeSolo": true
              },
              {
                "name": "value",
                "label": "Value",
                "type": "string",
                "acceptVariable": true,
                "acceptNodeOutputAsVariable": true
              }
            ],
            "id": "customFunctionAgentflow_0-input-customFunctionUpdateState-array"
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "customFunctionInputVariables": [],
          "customFunctionJavascriptFunction": "const normalize = (value) => String(value ?? '').normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\nconst office = '[Oficina de Defensa del Litigante](https://consejo.jusbaires.gob.ar/institucional/organigrama/oficina-de-defensa-del-litigante/)';\nconst contact = 'Podés comunicarte con la ' + office + ' al (011) 4008-0216 / 0272 o por correo a odl@jusbaires.gob.ar.';\nconst navigation = '\\n\\nEscribí **menú** para ver las opciones.';\nconst areas = [\n  ['REG', 'Registro y acceso'], ['FD', 'Firma digital'], ['ESC', 'Escritos judiciales'],\n  ['CED', 'Cédulas y notificaciones'], ['CON', 'Consultas y servicios'], ['SOP', 'Soporte técnico']\n];\nconst examples = {\n  REG: ['Crear una cuenta', 'Validación de identidad', 'Recuperar el acceso'],\n  FD: ['Configurar firma digital remota', 'Firmar con token', 'Verificar la firma de un PDF'],\n  ESC: ['Inicio de una causa', 'Presentar un escrito y adjuntos', 'Primera presentación'],\n  CED: ['Cédula electrónica', 'Cédula a domicilio físico', 'Cédula observada'],\n  CON: ['Buscar una causa pública', 'Consultar la agenda judicial', 'Consultar zonas de notificación'],\n  SOP: ['Ventanas emergentes', 'Problemas al adjuntar un PDF', 'Causa que no figura en Mis Causas']\n};\nfunction route(message) {\n  const input = String(message ?? '');\n  if (input.length > 3000) {\n    return 'Resumí tu consulta sin incluir datos personales ni copiar el contenido de documentos judiciales.' + navigation;\n  }\n  const q = normalize(input);\n  if (/\\b(?:venc\\w* hoy|plazo (?:perentorio|judicial|vence)|in extremis|habilitacion urgente|alta urgente|caducidad|prescripcion)\\b/.test(q)) {\n    return 'Si hay un posible vencimiento judicial, contactá de inmediato a tu profesional o a la dependencia que interviene para confirmar cómo proceder. Para asistencia con el Portal, ' + contact + ' El chat no confirma plazos ni registra presentaciones.';\n  }\n  if (/[\\w.+-]+@[\\w.-]+\\.[a-z]{2,}|\\b\\d{7,11}\\b|\\b\\d{2}-\\d{8}-\\d\\b/i.test(input) || /\\b(?:mi|el|la) (?:clave|otp|pin|contrasena|password|dni|cuit|cuil|codigo) (?:es|son)\\b/.test(q) || /\\b(?:mi )?(?:clave|otp|pin|contrase[nñ]a|password|dni|cuit|cuil)\\s*:/i.test(input)) {\n    return 'Para cuidar tu información, evitá compartir contraseñas, códigos o identificadores personales por este chat. Contame qué trámite querés hacer sin incluir esos datos.' + navigation;\n  }\n  if (/\\b(?:humano|operador|hablar con alguien|atencion personal|mi ticket|estado del ticket|abrir ticket|generar ticket)\\b/.test(q)) return contact + ' Este chat brinda orientación técnica.';\n  if (/\\b(?:me conviene|que estrategia|que recurso (?:debo|puedo)|calcul\\w+.*plazo|cuando vence|asesoramiento legal|que debo alegar)\\b/.test(q)) {\n    return 'Puedo orientarte en el uso del Portal. Para una decisión sobre tu caso o un plazo, consultá con tu profesional o con la dependencia que interviene.' + navigation;\n  }\n  if (/\\b(?:fuero nacional|fuero federal|lex100|scba|provincia de buenos aires|tribunal electoral|padron electoral)\\b/.test(q)) {\n    return 'Este chat orienta sobre el Portal del Litigante del Poder Judicial de la Ciudad de Buenos Aires. Para esa consulta, usá el canal del organismo que interviene.' + navigation;\n  }\n  if (!q || /^(?:hola|buen dia|buenas|menu|menu principal|inicio|volver|atras|ayuda)$/.test(q)) {\n    return '¡Hola! Soy el asistente de orientación para el Portal del Litigante. Elegí un número o contame tu consulta.\\n\\n' +\n      areas.map(([, name], index) => (index + 1) + '. ' + name).join('\\n');\n  }\n  const selected = q.match(/^(?:opcion )?([1-6])$/);\n  const area = selected ? areas[Number(selected[1]) - 1] : areas.find(([, name]) => normalize(name) === q);\n  if (area) {\n    return '**' + area[1] + '**\\n\\n¿Sobre qué tema necesitás orientación?\\n\\n' +\n      examples[area[0]].map((title) => '- ' + title).join('\\n') + navigation;\n  }\n  return 'BUSCARFICHA';\n}\n\nreturn route($flow.input);\n",
          "customFunctionUpdateState": []
        },
        "outputAnchors": [
          {
            "id": "customFunctionAgentflow_0-output-customFunctionAgentflow",
            "label": "Menú, privacidad y alcance",
            "name": "customFunctionAgentflow"
          }
        ],
        "outputs": {},
        "selected": false
