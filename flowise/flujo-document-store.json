          ],
          "customFunctionJavascriptFunction": "const normalize = (value) => String(value ?? '').normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\nconst sourceLabels = new Map([\n  ['https://eje.juscaba.gob.ar/iol-ui/p/inicio', 'Portal del Litigante'],\n  ['https://eje.juscaba.gob.ar/iol-ui/', 'Consulta Pública de EJE'],\n  ['https://firmar.gob.ar/firmador/', 'Firma Digital Remota'],\n  ['https://consejo.jusbaires.gob.ar/institucional/organigrama/oficina-de-defensa-del-litigante/', 'Oficina de Defensa del Litigante']\n]);\nconst navigation = '\\n\\nEscribí **menú** para ver las opciones.';\nconst fallback = 'No encontré una ficha suficientemente relacionada. Contame qué querés hacer en el Portal o en qué paso te trabaste. Para asistencia técnica, podés consultar a la [Oficina de Defensa del Litigante](https://consejo.jusbaires.gob.ar/institucional/organigrama/oficina-de-defensa-del-litigante/).' + navigation;\n\nfunction respond(question, retrieved) {\n  let documents;\n  try {\n    documents = Array.isArray(retrieved) ? retrieved : JSON.parse(retrieved);\n  } catch {\n    return fallback;\n  }\n  if (!Array.isArray(documents)) return fallback;\n  const query = normalize(question);\n  const queryWords = ' ' + query + ' ';\n  const matches = [];\n  for (const {pageContent} of documents) {\n    const ficha = String(pageContent ?? '').match(\n      /^# ([^\\n]+)\\s+Ficha (VEC-PL-[A-Z]+-\\d+)\\s+Consultas relacionadas: ([^\\n]+)\\s+Respuesta:\\s+([\\s\\S]+?)\\s+Fuente oficial: (https:\\/\\/[^\\s]+)\\s*$/\n    );\n    if (!ficha) continue;\n    const [, title, id, triggers, answer, source] = ficha;\n    if (!sourceLabels.has(source)) continue;\n    const phrases = [title, ...triggers.split(',')].map(normalize).filter(Boolean);\n    const score = normalize(title) === query ? Number.MAX_SAFE_INTEGER :\n      Math.max(0, ...phrases.filter(phrase => queryWords.includes(' ' + phrase + ' ')).map(phrase => phrase.split(' ').length));\n    if (score > 0) matches.push({title, id, answer, source, score});\n  }\n  matches.sort((a, b) => b.score - a.score);\n  const [first, second] = matches;\n  if (!first) return fallback;\n  if (second && first.id !== second.id && first.score === second.score) {\n    return '¿Te referís a **' + first.title + '** o a **' + second.title + '**?' + navigation;\n  }\n  return '**' + first.title + '**\\n\\n' + first.answer + '\\n\\n[' + sourceLabels.get(first.source) + '](' + first.source + ')' + navigation;\n}\n\nreturn respond($flow.input, $retrieved);\n",
